<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>App Icon Toolkit third-party licenses</title>
  <style>
    body { font-family: system-ui, sans-serif; line-height: 1.5; margin: 2rem auto; max-width: 72rem; padding: 0 1rem; }
    pre { background: #f5f5f5; overflow-x: auto; padding: 1rem; white-space: pre-wrap; }
  </style>
</head>
<body>
  <h1>App Icon Toolkit third-party licenses</h1>
  <p>This file lists licenses selected for dependencies included in release binaries.</p>
  {{#each licenses}}
  <section>
    <h2 id="{{id}}">{{name}}</h2>
    <p>Used by:</p>
    <ul>
      {{#each used_by}}
      <li>{{crate.name}} {{crate.version}}</li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</body>
</html>
